# Unified patch payloads intentionally preserve space-prefixed blank context
# lines and kernel-style tab indentation.
security_patch/*.patch -whitespace
scripts/sukisu_compat/*.patch -whitespace

# SUSFS driver compatibility patches must stay byte-identical to the patches
# generated from the merged trees. Declaring them text/binary-safe prevents
# core.autocrlf=true checkouts (Windows) from injecting CRLF into the patch
# payload, which makes `patch -p1` fail to match context lines at build time.
scripts/susfs_fixes/patches/*.patch -text -whitespace

# The manager-resolution script runs on Linux runners. Keep it LF-only so
# core.autocrlf=true checkouts (Windows) cannot turn it into a CRLF script.
scripts/ci/*.sh text eol=lf

# Same reasoning for the SUSFS patch pipeline: apply.sh appends exact lines such
# as "CFLAGS_exec.o += -DKSU_NO_PREINIT" to kernel Makefiles and greps for them
# with anchored patterns, so a CRLF checkout would break those checks.
scripts/susfs_fixes/*.sh text eol=lf
